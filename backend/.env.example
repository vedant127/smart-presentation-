# Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/smart-presentation-machine
MONGODB_TEST_URI=mongodb://localhost:27017/smart-presentation-test

# JWT Secret Keys
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this

# API Keys for External Integration
API_KEY_SECRET=your-api-key-secret-for-external-software-integration

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads
LIBRARY_PATH=./Library

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Integration (Optional - for future use)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
