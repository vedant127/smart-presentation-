{
    "info": {
        "name": "Smart Presentation Machine API",
        "description": "Complete API collection for Smart Presentation Machine",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@smartpresentation.com\",\n  \"password\": \"admin123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Profile",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/profile",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "profile"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Presentation Types",
            "item": [
                {
                    "name": "Get All Presentation Types",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/presentation-types",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "presentation-types"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Form Schema",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/presentation-types/{{presentationTypeId}}/form-schema",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "presentation-types",
                                "{{presentationTypeId}}",
                                "form-schema"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Presentations",
            "item": [
                {
                    "name": "Generate Presentation",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"presentationTypeId\": \"{{presentationTypeId}}\",\n  \"formData\": {},\n  \"plots\": [\n    {\n      \"plotNumber\": 1,\n      \"criteria\": {\n        \"City\": \"Riyadh\",\n        \"Asset Type\": \"Residential\",\n        \"Category\": \"Apartments\",\n        \"Specifications\": \"Luxury\"\n      }\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/presentations/generate",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "presentations",
                                "generate"
                            ]
                        }
                    }
                },
                {
                    "name": "Get History",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/presentations/history",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "presentations",
                                "history"
                            ]
                        }
                    }
                },
                {
                    "name": "Download Presentation",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/presentations/download/{{presentationId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "presentations",
                                "download",
                                "{{presentationId}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "API Keys",
            "item": [
                {
                    "name": "Create API Key",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Gemini API Key\",\n  \"provider\": \"gemini\",\n  \"key\": \"your-api-key-here\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/api-keys",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "api-keys"
                            ]
                        }
                    }
                },
                {
                    "name": "Get All API Keys",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/api-keys",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "api-keys"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "File Browser",
            "item": [
                {
                    "name": "Browse Library",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/files/browse?folderPath=",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "files",
                                "browse"
                            ],
                            "query": [
                                {
                                    "key": "folderPath",
                                    "value": ""
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Folder",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"folderPath\": \"Feasibility Study\",\n  \"folderName\": \"New Section\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/files/folder",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "files",
                                "folder"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "File Upload",
            "item": [
                {
                    "name": "Upload PPTX File",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": ""
                                },
                                {
                                    "key": "destinationPath",
                                    "value": "Feasibility Study/06_Market Overview",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/upload",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "upload"
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "presentationTypeId",
            "value": "",
            "type": "string"
        },
        {
            "key": "presentationId",
            "value": "",
            "type": "string"
        }
    ]
}